{
  "name": "tplan-desktop",
  "version": "0.1.0",
  "author": "T计划",
  "private": true,
  "description": "T计划 desktop pet (Windows): pet window, shared timer/records core, character resource packs",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "start:pet": "electron . --pet-only",
    "start:testpack": "electron . --pack=dev-fixtures/test-pack",
    "start:nogpu": "electron . --no-gpu",
    "test": "node --test \"test/*.test.js\"",
    "selftest": "electron . --pet-only --pack=dev-fixtures/test-pack --selftest=selftest-out",
    "selftest:nopack": "electron . --pet-only --no-default-pack --selftest=selftest-out-nopack",
    "test:windows": "node test/windows-smoke.cjs",
    "dist": "electron-builder --win portable",
    "pack": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  },
  "build": {
    "appId": "com.tplan.desktop",
    "productName": "T计划桌宠",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "directories": {"output": "dist"},
    "win": {"target": "portable", "signAndEditExecutable": false},
    "portable": {"artifactName": "TPlan-Pet-${version}-Windows.exe"}
  }
}
